						"details": "An operation with an ERC-20 token failed."
					}
				]
			},
			"kind": "dev",
			"methods": {
				"constructor": {
					"details": "Initializes with 3 default plans: Starter, Pro, Elite",
					"params": {
						"_usdc": "Address of the USDC token contract"
					}
				},
				"createPlan(string,uint256,uint256)": {
					"params": {
						"feeAmount": "Fee in USDC (6 decimals)",
						"name": "Plan name",
						"virtualCapital": "Virtual capital amount"
					}
				},
				"failTrader(address,string)": {
					"params": {
						"reason": "Reason for failure (e.g., \"Max Daily Loss Exceeded\")",
						"traderAddress": "Address of the trader who failed"
					}
				},
				"getPlan(uint256)": {
					"params": {
						"planId": "ID of the plan"
					},
					"returns": {
						"_0": "Plan struct with all details"
					}
				},
				"getTrader(address)": {
					"params": {
						"traderAddress": "Address of the trader"
					},
					"returns": {
						"_0": "Trader struct with all details"
					}
				},
				"getTraderStage(address)": {
					"params": {
						"traderAddress": "Address of the trader"
					}
				},
				"isActiveTrader(address)": {
					"params": {
						"traderAddress": "Address to check"
					}
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"restartChallenge(uint256)": {
					"params": {
						"planId": "The plan ID to restart with"
					}
				},
				"setPlanActive(uint256,bool)": {
					"params": {
						"active": "New active status",
						"planId": "Plan ID to update"
					}
				},
				"startChallenge(uint256)": {
					"params": {
						"planId": "The ID of the plan to enroll in (1, 2, or 3)"
					}
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				},
				"upgradeTrader(address)": {
					"details": "Only owner can call this after verifying off-chain trading performance",
					"params": {
						"traderAddress": "Address of the trader to upgrade"
					}
				},
				"withdrawFees(address)": {
					"params": {
						"to": "Address to send fees to"
					}
				}
			},
			"title": "PropFirmFactory",
			"version": 1
		},
